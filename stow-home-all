#!/usr/bin/env bash
set -euo pipefail #bash-safety-flags

if [[ $EUID -eq 0 ]]; then
    echo "Nicht mit sudo ausführen: würde nach /root statt nach /home/<user> verlinken." >&2
    exit 1
fi

EXCLUDE="system"
STOWDIR=$(dirname $(realpath $0))
STOWTARGET=$HOME

cd $STOWDIR
echo $STOWDIR "->" $STOWTARGET

for dir in */; do
    pkg="${dir%/}"
    [[ " $EXCLUDE " == *" $pkg "* ]] && continue
    echo ""
    echo $pkg
    stow --restow $pkg --target=$STOWTARGET --verbose=1
done